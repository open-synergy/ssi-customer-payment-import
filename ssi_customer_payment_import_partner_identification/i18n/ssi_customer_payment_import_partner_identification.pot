#. module: ssi_customer_payment_import_partner_identification
#: code:addons/ssi_customer_payment_import_partner_identification/models/customer_payment_import_data.py:0
#, python-format
msgid ""
"\n"
"Context: Processing customer payment import data line\n"
"Document: %s (sequence %s)\n"
"Problem: %s partners found with identification value '%s' under\n"
"         category '%s'\n"
"Solution: Ensure only one partner is registered with that\n"
"          identification value under this category\n"
"          (res.partner.id_number), correct the data in this line,\n"
"          then retry the queue job"
msgstr ""

#. module: ssi_customer_payment_import_partner_identification
#: code:addons/ssi_customer_payment_import_partner_identification/models/customer_payment_import_data.py:0
#, python-format
msgid ""
"\n"
"Context: Processing customer payment import data line\n"
"Document: %s (sequence %s)\n"
"Problem: No partner found with identification value '%s' under\n"
"         category '%s'\n"
"Solution: Register the identification number on the partner\n"
"          (res.partner.id_number), correct the data in this line, or\n"
"          adjust Partner Identification Category on the import Type,\n"
"          then retry the queue job"
msgstr ""

#. module: ssi_customer_payment_import_partner_identification
#: code:addons/ssi_customer_payment_import_partner_identification/models/customer_payment_import_type.py:0
#, python-format
msgid ""
"\n"
"Context: Saving customer payment import type\n"
"Type: %s\n"
"Problem: Partner Matching Method is 'Partner Identification' but\n"
"         Partner Identification Column or Partner Identification\n"
"         Category is empty\n"
"Solution: Fill in both Partner Identification Column and Partner\n"
"          Identification Category, or choose a different Partner\n"
"          Matching Method"
msgstr ""

#. module: ssi_customer_payment_import_partner_identification
#: model:ir.model.fields,help:ssi_customer_payment_import_partner_identification.field_customer_payment_import_type__partner_identification_column
msgid ""
"Column name (or 0-based index if No Header Line is checked) containing the "
"identification number used to identify the paying customer, matched against "
"res.partner.id_number. Required only when Partner Matching Method = Partner "
"Identification."
msgstr ""

