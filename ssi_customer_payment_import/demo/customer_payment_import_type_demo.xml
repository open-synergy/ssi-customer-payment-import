<odoo>
<record id="customer_payment_import_type_demo_1" model="customer_payment_import_type">
    <field name="name">Bank Statement CSV</field>
    <field name="code">BANK-CSV</field>
    <field name="file_type">csv</field>
    <field name="file_encoding">utf-8</field>
    <field name="delimiter">comma</field>
    <field name="no_header" eval="0" />
    <field name="skip_empty_lines" eval="1" />
    <field name="offset_row">0</field>
    <field name="trailing_offset_row">0</field>
    <field name="date_column">date</field>
    <field name="date_format">%Y-%m-%d</field>
    <field name="partner_bank_account_column">account_number</field>
    <field name="amount_column">amount</field>
    <field name="communication_column">description</field>
    <field name="auto_post" eval="0" />
    <field name="journal_selection_method">domain</field>
    <field name="journal_domain">[('type', '=', 'bank')]</field>
</record>
</odoo>
