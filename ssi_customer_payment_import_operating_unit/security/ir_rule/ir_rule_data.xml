<odoo>
<record id="customer_payment_import_rule_ou" model="ir.rule">
    <field
            name="name"
        >customer_payment_import - Responsible to operating unit data</field>
    <field
            name="model_id"
            ref="ssi_customer_payment_import.model_customer_payment_import"
        />
    <field name="groups" eval="[(4, ref('customer_payment_import_ou_group'))]" />
    <field
            name="domain_force"
        >[('operating_unit_id','in',[g.id for g in user.operating_unit_ids])]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>
</odoo>
